<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/buttonBackAddClient"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Новый клиент"
            android:textColor="#212121"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <EditText
        android:id="@+id/editClientName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Имя клиента *"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="15sp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/editClientPhone"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Телефон"
        android:inputType="phone"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="15sp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/editClientEmail"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="15sp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/editClientAddress"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Адрес"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="15sp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/editClientNote"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="top"
        android:hint="Примечание"
        android:inputType="textCapSentences|textMultiLine"
        android:padding="12dp"
        android:textSize="15sp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSaveClient"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Сохранить"
        android:textSize="16sp" />

</LinearLayout>